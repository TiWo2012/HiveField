{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hiveField Terminal",
  "version": "0.1.1",
  "identifier": "dev.hivefield.terminal",
  "build": {
    "beforeDevCommand": "bun run build",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "hiveField Terminal",
        "width": 960,
        "height": 600,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "transparent": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
