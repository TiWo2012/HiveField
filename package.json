{
  "name": "hivefield-terminal",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "A basic terminal built with Tauri and xterm.js",
  "scripts": {
    "build": "tsc --noEmit && bun build src/main.ts --outdir dist && cp index.html dist/",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "dev": "bun run build",
    "dev:no-reload": "tauri dev --no-watch --no-dev-server"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^5.5.0",
    "dockview": "^7.0.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "typescript": "^5"
  }
}
