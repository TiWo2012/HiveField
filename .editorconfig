# EditorConfig keeps indentation and line endings consistent across editors.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Rust uses rustfmt's default 4-space indent.
[*.rs]
indent_size = 4

# Cargo and TOML files follow the same 4-space convention as Rust.
[*.toml]
indent_size = 4

[*.{yml,yaml,json,jsonc,ts,tsx,js,jsx,css,html}]
indent_size = 2

[*.md]
# Markdown uses trailing double-spaces for hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
